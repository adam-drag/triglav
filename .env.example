# `node scripts/setup.ts` creates .env from this file with random keys. By hand: copy to .env and use hex values (openssl rand -hex 24), so they are safe inside URLs.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Agents send this as "Authorization: Bearer <key>" to the MCP endpoint. At least 24 characters. The host runner also reads it from this
# file, only to write the MCP config of the Claude research runs it starts (a 0600 file per run, removed when the run exits).
ORCH_ENROLLMENT_KEY=
# Only the host runner (scripts/runner.ts) sends this, to /api/runner/*. At least 24 characters and different from
# ORCH_ENROLLMENT_KEY: agents hold that one, and the runner starts processes on this machine.
ORCH_RUNNER_KEY=
# The dashboard password (8 to 1000 characters), as a scrypt hash. Do not fill this in by hand: run `node scripts/set-password.ts`.
ORCH_CLIENT_PASSWORD_HASH=
# Optional, read-only Linear personal API key. Without it, Staff passes ticket snapshots from Linear MCP.
LINEAR_API_KEY=
# Optional and off by default: a second, dashboard-only listener for an HTTPS reverse proxy. See "Running behind an HTTPS
# reverse proxy" in the README first: a remote Client session has full control of this machine. The https origin the
# proxy serves (no path), for example https://triglav.example.com. Also uncomment the two lines and the port in
# docker-compose.yml. Logging in through it needs a password of at least 16 characters.
ORCH_DASHBOARD_URL=
# Port of that listener (default 7410).
ORCH_DASHBOARD_PORT=
