# Copy to .env and fill in. Use hex values (openssl rand -hex 24) so they are safe inside URLs.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Agents send this as "Authorization: Bearer <key>" to the MCP endpoint. At least 24 characters.
ORCH_ENROLLMENT_KEY=
# Only the host runner (scripts/runner.ts) sends this, to /api/runner/*. At least 24 characters and different from
# ORCH_ENROLLMENT_KEY: agents hold that one, and the runner starts processes on this machine.
ORCH_RUNNER_KEY=
# The dashboard password, as a scrypt hash. Do not fill this in by hand: run `node scripts/set-password.ts`.
ORCH_CLIENT_PASSWORD_HASH=
# Optional, read-only Linear personal API key. Without it, Staff passes ticket snapshots from Linear MCP.
LINEAR_API_KEY=
