{
  "name": "triglav",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-drag/triglav.git"
  },
  "homepage": "https://github.com/adam-drag/triglav#readme",
  "bugs": "https://github.com/adam-drag/triglav/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run --maxWorkers=4",
    "build:web": "vite build web",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build --wait",
    "e2e": "playwright test",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "tinybench": "6.2.0"
    }
  }
}
